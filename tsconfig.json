{
    "compilerOptions": {
        "target": "es2020",
        "module": "esnext",
        "moduleResolution": "bundler",
        "strict": true,
        "noImplicitOverride": true,
        "rootDir": "source",
        "sourceMap": true,
        "declaration": true
    },
    "include": ["source/**/*.ts"],
    "exclude": ["source/**/*.test.ts"]
}
